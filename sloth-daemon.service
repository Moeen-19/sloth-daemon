# sloth-daemon.service: example systemd unit for sloth-daemon.
#
# Install:
#   sudo cp target/release/sloth-daemon /usr/local/bin/
#   sudo mkdir -p /etc/sloth-daemon && sudo cp sloth.toml /etc/sloth-daemon/sloth.toml
#   sudo cp sloth-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sloth-daemon
#
# systemd does not allow trailing comments on a setting line, so every comment
# in this file sits on its own line.

[Unit]
Description=Sloth Daemon - AI-assisted eBPF CPU governor
Documentation=https://github.com/Moeen-19/sloth-daemon
# Ordering only: start after Ollama if it is enabled, but never pull it in.
# Rules mode does not need Ollama, and Ollama uses a lot of memory on small machines.
After=network.target ollama.service

[Service]
Type=simple
ExecStart=/usr/local/bin/sloth-daemon --config /etc/sloth-daemon/sloth.toml
Restart=on-failure
RestartSec=5s

# Runs as root, but with a restricted capability set.
#   CAP_BPF     - load eBPF programs and maps
#   CAP_PERFMON - attach to the sched_switch and sched_process_exit tracepoints
# cgroup writes (mkdir, cpu.max, cgroup.procs) are checked by file permissions,
# which root passes, so no extra capability is expected to be needed.
# If a run fails with permission errors, see the Troubleshooting notes in README.md.
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_BPF CAP_PERFMON
AmbientCapabilities=CAP_BPF CAP_PERFMON

# Light hardening. The daemon must be able to write under /sys/fs/cgroup
# (it creates its own cgroup, and moves processes back to their original cgroup
# on release), so cgroupfs is left writable and kernel tunables are not locked.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectControlGroups=no

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target